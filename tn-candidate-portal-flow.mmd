%% TalentNext — Candidate Portal · end-to-end screen journey
%% Vocabulary: Quiz = free pre-account questionnaire · Assessment = graded chapter quiz
%% Evaluation = AI + reviewer judgement from an interview · Level = the resulting E/B/T band
%% Module prefixes match the portal sidebar.

flowchart TD

%% ==================================================================
%% STAGE 0 — PRE-ACCOUNT (outside the portal)
%% ==================================================================
subgraph S0["STAGE 0 · Pre-account — outside the portal"]
direction TB
  A1["NIL landing page<br/>marketing, referral, QR, university, agent"]
  A2["Quiz<br/>10-15 behavioural questions"]
  A3["Name + email captured<br/>before any result is shown"]
  A4["Quiz result<br/>bucket + provisional band"]
  A5{"Wants to go<br/>further?"}
  A6["Bucket-specific offers<br/>course and interview, each priced"]
  A7["Create account<br/>origin and attribution captured"]
  DE1(["DEAD END · Lead stored<br/>re-surfaced by marketing, no seat consumed"])
end

A1 --> A2 --> A3 --> A4 --> A5
A5 -->|no| DE1
DE1 -.->|returns later| A4
A5 -->|yes| A6 --> A7

%% ==================================================================
%% STAGE 1 — IN PORTAL, NOT YET LEVELLED
%% ==================================================================
subgraph S1["STAGE 1 · In portal, not yet levelled"]
direction TB
  B1["Overview<br/>next action: get levelled"]
  B2["My Level<br/>quiz baseline, no evaluation yet"]
  B3["Interviews<br/>agent marketplace, browse and filter"]
  B4["Interviews<br/>agent detail: price, rank, completion rate"]
  B5{"Agent charges<br/>a fee?"}
  B6["Payments<br/>card checkout, platform collects"]
  B7["Interviews<br/>slot picker"]
  B8["Interviews<br/>booking confirmed"]
end

A7 --> B1
B1 --> B2
B1 --> B3
B2 -->|book an interview| B3
B3 --> B4 --> B5
B5 -->|yes| B6 --> B7
B5 -->|no, free session| B7
B7 --> B8

%% ==================================================================
%% STAGE 2 — INTERVIEW AND EVALUATION
%% ==================================================================
subgraph S2["STAGE 2 · Interview and evaluation"]
direction TB
  C1["Overview<br/>interview booked, prep checklist"]
  C2["Interviews<br/>upcoming session"]
  C3{"Attends the<br/>session?"}
  C4["Interviews<br/>reschedule, free up to 24h before"]
  C5["Payments<br/>full refund issued"]
  C6["Live interview<br/>recorded, transcript generated"]
  SYS1[["AI analysis<br/>transcript combined with quiz data"]]
  C7["Reviewer decision"]
  C8{"Reviewer agrees<br/>with the AI?"}
  C9["Reviewer override<br/>reason recorded"]
  C10["Level assigned<br/>E1-E5, B1-B5 or T1-T5"]
  C11["My Level<br/>level report published: level, strengths, growth areas, recording, transcript"]
  DE2(["DEAD END · No-show<br/>reschedule or drop out of the funnel"])
end

B8 --> C1 --> C2 --> C3
C3 -->|reschedules| C4 --> C2
C3 -->|cancels| C5 --> B3
C3 -->|no-show| DE2
DE2 -.->|rebooks| C4
C3 -->|yes| C6 --> SYS1 --> C7 --> C8
C8 -->|yes| C10
C8 -->|no| C9 --> C10
C10 --> C11

%% ==================================================================
%% STAGE 3 — LEVELLED, DECIDING WHETHER TO ENROL
%% ==================================================================
subgraph S3["STAGE 3 · Levelled, deciding whether to enrol"]
direction TB
  E1["Overview<br/>next action: enrol"]
  E2["My Level<br/>report plus recommended course for this level"]
  E3["Coursework preview<br/>chapter outline, duration, price"]
  E4{"Enrols in<br/>the course?"}
  E5["Payments<br/>course fee upfront, one payment for 90 days"]
  E6["Cohort assigned<br/>max 10, grouped from quiz and evaluation data"]
  E7{"Multiple class<br/>times offered?"}
  E8["Cohort<br/>candidate picks a slot"]
  E9["Cohort<br/>single slot assigned"]
  E10["Enrolment confirmed<br/>coursework, assignments and cohort unlock"]
  DE3(["DEAD END · Levelled, not enrolled<br/>level retained, account dormant"])
end

C11 --> E1
E1 --> E2 --> E3 --> E4
E4 -->|no| DE3
DE3 -.->|returns later| E3
DE3 -.->|re-evaluates instead| B3
E4 -->|yes| E5 --> E6 --> E7
E7 -->|yes| E8 --> E10
E7 -->|no| E9 --> E10

%% ==================================================================
%% STAGE 4 — THE 90-DAY LOOP (repeats weekly, 13 times)
%% ==================================================================
subgraph S4["STAGE 4 · The 90-day loop — repeats weekly x13"]
direction TB
  F1["Overview<br/>day N of 90, pace vs progress, next action"]
  F2["Coursework<br/>chapter list, locked and unlocked"]
  F3["Coursework<br/>chapter player: video"]
  F4{"Video<br/>finished?"}
  F5["Coursework<br/>chapter assessment, N questions"]
  F6{"Score at or above<br/>pass mark?"}
  F7["Coursework<br/>retake, revolution count +1"]
  F8["Chapter complete<br/>next chapter unlocks"]
  F9["Coursework<br/>notes and chapter resources"]

  G1["Assignments<br/>this week's practical task"]
  G2["Assignments<br/>write and submit response"]
  G3{"Submitted by<br/>the due date?"}
  G4["Assignments<br/>marked late, visible to agent"]
  G5["Assignments<br/>marked on time"]
  G6[["Agent reviews submissions<br/>before the cohort call"]]

  H1["Cohort<br/>weekly live call"]
  H2{"Attends<br/>the call?"}
  H3["Cohort<br/>recording plus agent notes"]
  H4["Cohort<br/>discussion thread and peer standings"]

  I1["Messages<br/>1:1 thread with the agent"]
  I2["Transcript<br/>running record updates"]
  J1{"Week 13<br/>complete?"}
  DE4(["DEAD END · Inactive<br/>flagged to agent, outreach, re-engage or lapse"])
end

E10 --> F1
F1 --> F2 --> F3 --> F4
F4 -->|no| F3
F4 -->|yes| F5 --> F6
F6 -->|no| F7 --> F5
F6 -->|yes| F8
F3 --> F9
F8 --> I2

F1 --> G1 --> G2 --> G3
G3 -->|no| G4 --> G6
G3 -->|yes| G5 --> G6
G6 --> H1

F1 --> H1 --> H2
H2 -->|no| H3 --> H4
H2 -->|yes| H4
H4 --> I2
F1 --> I1 --> I2

I2 --> J1
J1 -->|no, next week| F1
J1 -->|no activity for N days| DE4
DE4 -.->|re-engages| F1
DE4 -.->|lapses| DE3

%% ==================================================================
%% STAGE 5 — COMPLETION AND RE-EVALUATION
%% ==================================================================
subgraph S5["STAGE 5 · Completion and re-evaluation"]
direction TB
  K1[["Agent publishes completion summary<br/>coursework data plus agent observations"]]
  K2["Transcript<br/>summary, certificate if complete, full chapter record"]
  K3{"Books a<br/>re-interview?"}
  K4["Interviews<br/>re-book, any agent, summary sent ahead"]
  K5["Payments<br/>re-interview fee"]
  K6["Live re-interview<br/>agent has read the summary first"]
  SYS2[["AI plus reviewer evaluation<br/>interview, coursework record, agent summary"]]
  K7{"Outcome?"}
  K8["Level up<br/>promoted one band"]
  K9["Level held<br/>repeat the same level"]
  K10["Level down<br/>moved back one band"]
  K11["My Level<br/>level history updated across cycles"]
  DE5(["DEAD END · Course complete, no level movement<br/>certificate retained, can return later"])
end

J1 -->|yes| K1 --> K2 --> K3
K3 -->|no| DE5
DE5 -.->|returns later| K3
K3 -->|yes| K4 --> K5 --> K6 --> SYS2 --> K7
K7 -->|improved| K8 --> K11
K7 -->|no change| K9 --> K11
K7 -->|regressed| K10 --> K11

%% ==================================================================
%% STAGE 6 — NEXT CYCLE
%% ==================================================================
subgraph S6["STAGE 6 · Next cycle"]
direction TB
  M1["Overview<br/>new level, next course offered"]
  M2{"Enrols in the<br/>next course?"}
  M3["Payments<br/>next course fee"]
  M4["New cohort assigned<br/>cycle 2, fresh coursework and assignments"]
  M5{"Level at or above<br/>employer threshold?"}
  M6["Employer visibility unlocks<br/>SCOPE NOT AGREED"]
  DE6(["DEAD END · Dormant<br/>level and transcript retained indefinitely"])
  DE7(["Not yet eligible<br/>needs another cycle"])
end

K11 --> M1 --> M2
M2 -->|no| DE6
DE6 -.->|returns later| M1
M2 -->|yes| M3 --> M4
M4 ==>|loop back, cycle 2| F1
K11 --> M5
M5 -->|yes| M6
M5 -->|no| DE7
DE7 -.-> M1

%% ==================================================================
%% ALWAYS AVAILABLE
%% ==================================================================
subgraph S7["Available at every stage"]
direction LR
  N1["Settings · Payments<br/>transactions, receipts, refunds"]
  N2["Settings · Account<br/>identity, notification prefs, timezone, deletion"]
  N3["Notifications<br/>header element, not a sidebar module"]
end

%% ==================================================================
%% STYLING
%% ==================================================================
classDef screen fill:#ffffff,stroke:#c9cdd6,stroke-width:1px,color:#16181d
classDef decision fill:#fdf6e3,stroke:#e0c07a,stroke-width:1px,color:#5a4300
classDef system fill:#eef0fb,stroke:#b9bfe8,stroke-width:1px,color:#2b2f6b
classDef deadend fill:#fdeeee,stroke:#e8b4b4,stroke-width:1px,color:#8f1d1d
classDef money fill:#ecfdf5,stroke:#a3d9c0,stroke-width:1px,color:#065f42
classDef level fill:#16181d,stroke:#16181d,stroke-width:1px,color:#ffffff
classDef always fill:#f4f5f8,stroke:#cfd2da,stroke-width:1px,color:#4d5361

class A1,A2,A3,A4,A6,A7,B1,B2,B3,B4,B7,B8,C1,C2,C4,C6,C11,E1,E2,E3,E6,E8,E9,E10,F1,F2,F3,F5,F7,F8,F9,G1,G2,G4,G5,H1,H3,H4,I1,I2,K2,K4,K6,M1,M4,M6 screen
class A5,B5,C3,C8,E4,E7,F4,F6,G3,H2,J1,K3,K7,M2,M5 decision
class SYS1,SYS2,C7,G6,K1 system
class DE1,DE2,DE3,DE4,DE5,DE6,DE7 deadend
class B6,C5,E5,K5,M3 money
class C9,C10,K8,K9,K10,K11 level
class N1,N2,N3 always

style S0 fill:#fafbfc,stroke:#dfe2e8,color:#4d5361
style S1 fill:#fafbfc,stroke:#dfe2e8,color:#4d5361
style S2 fill:#fafbfc,stroke:#dfe2e8,color:#4d5361
style S3 fill:#fafbfc,stroke:#dfe2e8,color:#4d5361
style S4 fill:#f7f6fd,stroke:#d6d0f5,color:#4a31b8
style S5 fill:#fafbfc,stroke:#dfe2e8,color:#4d5361
style S6 fill:#fafbfc,stroke:#dfe2e8,color:#4d5361
style S7 fill:#f4f5f8,stroke:#cfd2da,color:#4d5361
